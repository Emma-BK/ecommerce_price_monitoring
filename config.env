# ==============================================================
# SECRETS & CONFIGURATION DU PROJET ECOMMERCE
# ==============================================================

# ----------------- Base de Données -----------------
# Par défaut, nous utilisons SQLite pour le fonctionnement Plug&Play du projet.
# Pour la production, commentez la ligne SQLite et décommentez celle de PostgreSQL.
DATABASE_URL=sqlite:///ecommerce_prices.db
#DATABASE_URL=postgresql://admin:superSecret@localhost:5432/ecommerce_db

# ----------------- API Keys (Optionnel) -----------------
# Si vous utilisez un proxy scraper type ScraperAPI, ZenRows etc.
SCRAPER_API_KEY=YOUR_API_KEY_HERE_IF_NEEDED
USE_PROXY_ROTATION=False

# ----------------- Configuration FastAPI -----------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG_MODE=True

# ----------------- Machine Learning -----------------
# Nombre de jours dans le futur à prédire
PREDICTION_HORIZON_DAYS=7

# Interval de scraping
SCRAPING_INTERVAL_MINUTES=1440

# Exigence MAPE pour que le modèle valide l'entrainement.
MAPE_TARGET_THRESHOLD=0.06
